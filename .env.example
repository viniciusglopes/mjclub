# MJCLUB — variáveis de ambiente
#
# Sem nenhuma delas o app roda no driver `demo` (dados em memória), que é o
# suficiente para navegar a POC inteira. Preencha a URL e a service role key
# para apontar para um Postgres real do Supabase.

# Projeto Supabase — Settings › API Keys
#
# Sem prefixo NEXT_PUBLIC_: é lida em tempo de execução, então a mesma imagem
# Docker serve para qualquer ambiente. Nada aqui fala com o Supabase pelo
# navegador.
SUPABASE_URL=

# A secret/service_role key ignora RLS: é o servidor agindo em nome da
# barbearia (confirmar agendamento de convidado, validar resgate no balcão).
# NUNCA prefixe com NEXT_PUBLIC_, não comite e não cole em chat.
SUPABASE_SERVICE_ROLE_KEY=

# Tenant padrão. Deixe vazio para usar a MJ Barbearia do seed.
MJCLUB_TENANT_ID=

# Segredo do cookie de sessão da POC. Gere com: openssl rand -base64 32
POC_SESSION_SECRET=
